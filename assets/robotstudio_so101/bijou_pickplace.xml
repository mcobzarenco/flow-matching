<mujoco model="bijou_so101_pickplace">
  <!-- Bijou task scene (ours, not menagerie's): SO-101 + benchy + wooden
       disk. Lives inside the vendored robotstudio_so101/ dir because
       so101.xml declares meshdir="assets", which resolves relative to the
       MAIN file - this one. Workspace placement follows the menagerie
       pickup keyframe: graspable objects ~0.22 m along +x. -->
  <include file="so101.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="160" elevation="-20" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="2d" name="tabletop" builtin="checker" mark="cross" rgb1="0.86 0.84 0.80"
      rgb2="0.82 0.80 0.76" markrgb="0.7 0.7 0.7" width="300" height="300"/>
    <material name="tabletop" texture="tabletop" texuniform="true" texrepeat="8 8" reflectance="0.05"/>
    <!-- Flat white texture: the runtime tints it via geom rgba (cheap
         randomization) or paints tex_data directly (full randomization). -->
    <texture type="2d" name="benchy_tex" builtin="flat" rgb1="1 1 1" width="256" height="256"/>
    <material name="benchy_mat" texture="benchy_tex" specular="0.3" shininess="0.3"/>
    <material name="wood_disk" rgba="0.62 0.44 0.26 1" specular="0.1" shininess="0.1"/>
    <!-- meshdir="assets" (from so101.xml) resolves relative to THIS file's
         dir, so benchy at sim/assets/benchy needs ../../ -->
    <mesh name="benchy_visual" file="../../benchy/benchy_visual.obj"/>
    <mesh name="benchy_collision" file="../../benchy/benchy_collision.obj"/>
  </asset>

  <worldbody>
    <light pos="0.2 0 1.5" dir="0 0 -1" directional="true"/>
    <light pos="0.6 0.4 0.8" dir="-0.4 -0.4 -0.8" diffuse="0.3 0.3 0.3"/>
    <geom name="table" size="0 0 0.05" pos="0 0 0" type="plane" material="tabletop"/>

    <!-- Top camera: looks straight down at the workspace center; image
         "up" = world +x (the arm's forward), a natural tabletop view. -->
    <camera name="top_cam" pos="0.22 0 0.65" xyaxes="0 -1 0 1 0 0" fovy="58"/>

    <geom name="disk" type="cylinder" size="0.06 0.004" pos="0.22 0.11 0.004" material="wood_disk"/>

    <body name="benchy" pos="0.22 -0.08 0.001">
      <freejoint name="benchy_free"/>
      <geom name="benchy_visual" type="mesh" mesh="benchy_visual" material="benchy_mat"
        contype="0" conaffinity="0" group="2" density="0"/>
      <geom name="benchy_collision" type="mesh" mesh="benchy_collision" mass="0.04"
        friction="1 .03 .003" solref="0.01 1" group="3" rgba="0.5 0.5 0.5 0.3"/>
    </body>
  </worldbody>
</mujoco>
