<mujoco model="bijou_so101_pickplace">
  <!-- Bijou task scene (ours, not menagerie's): SO-101 + benchy + wooden
       disk. Lives inside the vendored robotstudio_so101/ dir because
       so101.xml declares meshdir="assets", which resolves relative to the
       MAIN file - this one. Workspace placement follows the menagerie
       pickup keyframe: graspable objects ~0.22 m along +x. -->
  <include file="so101.xml"/>

  <visual>
    <!-- Bright diffuse daylight look of the rig frames. -->
    <headlight diffuse="0.45 0.45 0.45" ambient="0.35 0.35 0.35" specular="0 0 0"/>
    <global azimuth="160" elevation="-20" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <model name="so101_leader" file="so101.xml"/>
    <!-- Photo texture cropped from a real front frame (assets/table). The
         real planks run along +x (away from the camera). -->
    <texture type="2d" name="tabletop" file="../table/table_texture.png"/>
    <!-- Mirror-tiled seamless texture (sim/make_table_texture.py); one
         2x2-mirrored tile covers ~0.4 m, sized to the 2.4 x 1.0 top so
         plank scale reads naturally. -->
    <material name="tabletop" texture="tabletop" texrepeat="6 2.5" reflectance="0.02"
      rgba="0.74 0.72 0.70 1"/>
    <!-- Flat white texture: the runtime tints it via geom rgba (cheap
         randomization) or paints tex_data directly (full randomization). -->
    <texture type="2d" name="benchy_tex" builtin="flat" rgb1="1 1 1" width="256" height="256"/>
    <material name="benchy_mat" texture="benchy_tex" specular="0.3" shininess="0.3"/>
    <material name="wood_disk" rgba="0.87 0.78 0.62 1" specular="0.1" shininess="0.1"/>
    <!-- meshdir="assets" (from so101.xml) resolves relative to THIS file's
         dir, so benchy at assets/benchy needs ../../. Collision pieces
         are a generated CoACD decomposition (convert_benchy.py): a single
         convex hull measured 2.63x the boat's volume and batted the boat
         around before visual contact. -->
    <mesh name="benchy_visual" file="../../benchy/benchy_visual.obj"/>
  </asset>
  <include file="../benchy/benchy_col_assets.xml"/>

  <worldbody>
    <light pos="0.2 0 1.5" dir="0 0 -1" directional="true" diffuse="0.45 0.45 0.45"/>
    <light pos="0.6 0.4 0.8" dir="-0.4 -0.4 -0.8" diffuse="0.25 0.25 0.25"/>
    <!-- Rig geometry (owner-measured): 1 m x 2.4 m table; both arms on
         the short (1 m, along y) edge; follower base = origin, 28 cm
         from the +y corner; leader 25 cm along -y; table extends 2.4 m
         along +x. Arms are clamped at the very edge: the base plate's
         rear face (measured from the model: x = -0.056) IS the table
         edge. -->
    <geom name="table" type="box" size="1.2 0.5 0.02" pos="1.144 -0.22 -0.02" material="tabletop"/>
    <geom name="room_floor" size="0 0 0.05" pos="0 0 -0.8" type="plane" rgba="0.55 0.55 0.58 1"/>

    <!-- "front" rig camera: on a rectangular pole between the two arms,
         lens 56 cm above the table, pitched 20 deg off vertical into the
         workspace (+x). Image right = -y (leader side), image up = +x. -->
    <!-- Pole clamped to the table edge between the arms, standing over
         the table like the arms' clamps: its rear face flush with the
         edge (x = -0.056), body over the table. Lens on the pole's
         front face. -->
    <geom name="camera_pole" type="box" size="0.015 0.02 0.28" pos="-0.041 -0.125 0.28"
      contype="0" conaffinity="0" rgba="0.2 0.2 0.2 1"/>
    <!-- fovy: the modules are "130 deg wide-angle" 1080p UVC cams, but
         that spec is the 16:9 diagonal - the rig captures 4:3 640x480,
         a heavy center crop. Disk pixel-size in the real frame implies
         an effective vertical FOV near 48 deg. -->
    <camera name="top_cam" pos="-0.02 -0.125 0.555"
      xyaxes="0 -1 0 0.9397 0 0.3420" fovy="52"/>

    <!-- Beech disk, ~8 cm like the real one. -->
    <geom name="disk" type="cylinder" size="0.04 0.006" pos="0.22 0.11 0.006" material="wood_disk"/>

    <!-- Stand-ins for the persistent clutter in the rig frames. -->
    <geom name="mouse" type="ellipsoid" size="0.032 0.055 0.02" pos="0.40 -0.22 0.02"
      euler="0 0 0.4" rgba="0.35 0.36 0.38 1"/>
    <body name="mug" pos="0.48 -0.02 0.045">
      <geom name="mug" type="cylinder" size="0.042 0.045" rgba="0.92 0.91 0.88 1"/>
    </body>

    <!-- The teleop leader arm: 25 cm along -y from the follower, same
         edge, same facing; joints posed raised per reset (the operator's
         hand is not modeled). -->
    <body name="leader_mount" pos="0 -0.25 0">
      <attach model="so101_leader" body="base" prefix="leader-"/>
    </body>

    <!-- Physics (measured, probe_benchy_drift): the hull rests on few
         contact points; default condim 3 has NO torsional/rolling
         friction, so the boat spun 43 deg / drifted 9 mm per 10 s
         untouched. condim 6 + tors/roll friction -> 0.06 mm / 0.01 deg;
         joint damping + harder solref decay the residual micro-jiggle
         (MuJoCo never sleeps). Those params ride in the generated
         collision include. -->
    <body name="benchy" pos="0.22 -0.08 0.001">
      <joint name="benchy_free" type="free" damping="0.05"/>
      <geom name="benchy_visual" type="mesh" mesh="benchy_visual" material="benchy_mat"
        contype="0" conaffinity="0" group="2" density="0"/>
      <include file="../benchy/benchy_col_geoms.xml"/>
    </body>
  </worldbody>
</mujoco>
